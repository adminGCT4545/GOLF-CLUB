PORT=3001
NODE_ENV=development
JWT_SECRET=royal_golf_club_jwt_secret_key_2024
JWT_REFRESH_SECRET=royal_golf_club_refresh_secret_key_2024
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/golf_club_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=golf_club_db
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:9190,http://localhost:3001

# Service URLs
MEMBER_SERVICES_URL=http://localhost:3002
ERP_SERVICES_URL=http://localhost:3003
AI_SERVICES_URL=http://localhost:8000
COMMUNICATION_API_URL=http://localhost:3004

# File Upload Configuration
MAX_FILE_SIZE=10mb
UPLOAD_PATH=./uploads

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@royalgolfclub.com

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
