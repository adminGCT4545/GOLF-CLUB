# Royal Golf Club ERP Environment Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=golf_club_db
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_make_it_very_long_and_secure_royal_golf_club_2025
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_also_very_long_and_secure_royal_golf_club_2025

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123`

# LM Studio Configuration
LM_STUDIO_URL=http://192.168.0.204:4545

# ChromaDB Hosts
CHROMADB_OPERATIONS_HOST=chromadb-operations:8001
CHROMADB_MEMBER_SERVICES_HOST=chromadb-member-services:8002
CHROMADB_FINANCIAL_HOST=chromadb-financial:8003
CHROMADB_MAINTENANCE_HOST=chromadb-maintenance:8004

# External API Keys
WHATSAPP_API_KEY=your_whatsapp_business_api_key
EMAIL_SERVICE_KEY=your_email_service_api_key
SMS_SERVICE_KEY=your_sms_service_api_key

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# Environment
NODE_ENV=development
ENVIRONMENT=development

# Logging
LOG_LEVEL=info

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,jpeg,png

# AI Configuration
AI_MODEL_TEMPERATURE=0.7
AI_MAX_TOKENS=1000
AI_CONTEXT_WINDOW=4096

# Analytics
ENABLE_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=90

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backups

# Monitoring
HEALTH_CHECK_INTERVAL=30
METRICS_COLLECTION=true
ALERT_EMAIL=admin@royalgolfclub.com

# Performance
CACHE_TTL=3600
CONNECTION_POOL_SIZE=20
QUERY_TIMEOUT=30000

# Features
ENABLE_AI_FEATURES=true
ENABLE_PREDICTIVE_ANALYTICS=true
ENABLE_DOCUMENT_PROCESSING=true
ENABLE_REAL_TIME_NOTIFICATIONS=true
